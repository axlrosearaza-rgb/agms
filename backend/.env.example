# Server
PORT=5000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=agms_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password
# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:3000

# Frontend URL used to build links inside emails (password reset, approval notice)
FRONTEND_URL=http://localhost:3000

# Gmail SMTP — sends password-reset and registration-approval emails.
# EMAIL_USER: a Gmail address you control (this is the "From" address).
# EMAIL_PASS: a 16-character Gmail "App Password" — NOT your normal Gmail password.
#   1. Turn on 2-Step Verification on that Gmail account: myaccount.google.com/security
#   2. Generate an App Password: myaccount.google.com/apppasswords
#   3. Paste the 16-character value here (spaces don't matter).
# Leave both blank during development — emails will be logged to the console instead.
EMAIL_USER=
EMAIL_PASS=

# --- Scale / performance tuning (all optional; sensible defaults are built in) ---
# Max Postgres connections this process may open. Keep it comfortably under
# Postgres max_connections (default 100), leaving room for psql/migrations.
# DB_POOL_MAX=40
# Log any API request slower than this many ms as "[slow] METHOD /path status ms".
# SLOW_REQUEST_MS=2000
# libuv worker threads (password hashing runs here). Default 16.
# UV_THREADPOOL_SIZE=16

# Offline mode — run with no Wi-Fi / internet: no e-mail is sent, and steps
# that wait for an e-mailed code are skipped (utils/offline.js).
# true = offline, false = online (needs EMAIL_USER / EMAIL_PASS above).
OFFLINE_MODE=false
